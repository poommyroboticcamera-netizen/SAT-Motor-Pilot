diff --git a/vescinterface.cpp b/vescinterface.cpp
index 46146d9..5f44168 100755
--- a/vescinterface.cpp
+++ b/vescinterface.cpp
@@ -3322,6 +3322,11 @@ void VescInterface::timerSlot()
 
 void VescInterface::packetDataToSend(QByteArray &data)
 {
+    // Audit captures are disconnected UI/configuration tests, never device tests.
+    if (!qgetenv("MOTORLAB_AUDIT_DIR").isEmpty()) {
+        qWarning() << "MotorLab audit: physical packet transmission blocked";
+        return;
+    }
 #ifdef HAS_SERIALPORT
     if (mSerialPort->isOpen()) {
         mSerialPort->write(data);
@@ -4192,6 +4197,10 @@ void VescInterface::mcconfUpdated()
 
 void VescInterface::ackReceived(QString ackType)
 {
+    if (ackType == "Motor config write OK" || ackType == "App config write OK") {
+        emit statusMessage(tr("Device acknowledged configuration write; readback verification pending"), false);
+        return;
+    }
     emit statusMessage(ackType, true);
 }
 
